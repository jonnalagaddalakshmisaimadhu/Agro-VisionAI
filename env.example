# FarmIQ Environment Variables
# Copy this file to .env.local for local development

# Google Gemini API Key (site-wide fallback)
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# Chatbot-specific configuration (preferred by FarmIQ Assistance)
VITE_CHATBOT_GEMINI_API_KEY=your-chatbot-gemini-api-key-here
VITE_CHATBOT_MODEL=gemini-1.5-flash

# API Base URL (Backend server for the main site)
VITE_API_URL=http://localhost:8000

# Development settings
VITE_NODE_ENV=development

# Optional: OpenAI API Key (Fallback)
VITE_OPENAI_API_KEY=your-openai-api-key-here
